# iRescue.life Production Environment Variables Template
# Copy this file and fill in the values for your production deployment
# Add these secrets in Replit's Secrets tool (Tools → Secrets)

# ============================================================================
# CRITICAL SECURITY VARIABLES (REQUIRED)
# ============================================================================

# Session Secret - MUST be 32+ characters, cryptographically random
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Encryption Key - MUST be 32+ characters, cryptographically random  
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# ============================================================================
# DATABASE (Auto-configured by Replit PostgreSQL)
# ============================================================================

# These are automatically set by Replit when you add PostgreSQL
DATABASE_URL=
PGHOST=
PGUSER=
PGDATABASE=
PGPASSWORD=
PGPORT=

# ============================================================================
# APPLICATION ENVIRONMENT
# ============================================================================

# Node Environment - Set to "production" for production deployment
NODE_ENV=production

# Port (auto-configured by Replit)
PORT=5000

# ============================================================================
# CORS SECURITY (REQUIRED in production)
# ============================================================================

# Comma-separated list of allowed origins
# Include all domains and subdomains that need to access the API
ALLOWED_ORIGINS=https://irescue.life,https://platform.irescue.life,https://www.irescue.life,https://*.irescue.life

# ============================================================================
# STRIPE PAYMENT PROCESSING (Production Keys)
# ============================================================================

# Stripe Secret Key (Production)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# Stripe Public Key (Production) - Available to frontend
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLIC_KEY=pk_live_...

# Stripe Webhook Secret (for subscription webhooks)
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================================
# STRIPE SUBSCRIPTION PRICE IDS (Production)
# ============================================================================

# Create these in Stripe Dashboard → Products
# Note: These are PRODUCTION price IDs, not test mode

# Starter Plan - $12/month
# Get from: Stripe Dashboard → Products → Starter → Pricing
VITE_STRIPE_STARTER_PRICE_ID=price_1SOtE7LdPuCw6ccP9Sq17ire

# Professional Plan - $39/month
# Get from: Stripe Dashboard → Products → Professional → Pricing
VITE_STRIPE_PROFESSIONAL_PRICE_ID=price_1SOtE8LdPuCw6ccPxC93YTaw

# Enterprise Plan - $99/month
# Get from: Stripe Dashboard → Products → Enterprise → Pricing
VITE_STRIPE_ENTERPRISE_PRICE_ID=price_1SOtE8LdPuCw6ccPJekqBaBi

# ============================================================================
# STRIPE TESTING KEYS (For Development/Testing)
# ============================================================================

# These are used during testing and development
# The application will prefer TESTING_ prefixed variables when available
# Keep these set to test mode values

# Stripe Test Keys
TESTING_STRIPE_SECRET_KEY=sk_test_...
TESTING_VITE_STRIPE_PUBLIC_KEY=pk_test_...

# Stripe Test Price IDs
TESTING_VITE_STRIPE_STARTER_PRICE_ID=price_1SOtpzJku6iORNL0YSn5nwRR
TESTING_VITE_STRIPE_PROFESSIONAL_PRICE_ID=price_1SOtpzJku6iORNL0ykSjNiQ2
TESTING_VITE_STRIPE_ENTERPRISE_PRICE_ID=price_1SOtpzJku6iORNL0x1EUgFUN

# ============================================================================
# EMAIL SERVICE (Resend)
# ============================================================================

# Platform-wide Resend API Key (Recommended)
# Get from: https://resend.com/api-keys
# This allows the platform to send system emails
PLATFORM_RESEND_API_KEY=re_...

# Tenant-specific Resend API Key (Optional)
# If tenants bring their own Resend account
RESEND_API_KEY=re_...

# ============================================================================
# OBJECT STORAGE (Auto-configured by Replit)
# ============================================================================

# These are automatically set by Replit Object Storage
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# ============================================================================
# OPTIONAL PAYMENT PROCESSORS
# ============================================================================

# PayPal (Optional - for donation processing)
# Get from: https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ============================================================================
# DEPLOYMENT TRACKING
# ============================================================================

# These are automatically set by Replit during deployment
# Do not set manually
REPLIT_DEPLOYMENT=1
REPLIT_DEV_DOMAIN=

# ============================================================================
# NOTES
# ============================================================================

# 1. Never commit this file with actual secrets
# 2. Add all secrets in Replit's Secrets tool (Tools → Secrets)
# 3. Frontend variables (VITE_*) must be prefixed with VITE_ to be accessible in client code
# 4. Backend-only secrets should NOT have the VITE_ prefix for security
# 5. The application automatically switches between test and production Stripe keys based on environment
# 6. Always use production Stripe keys (sk_live_*, pk_live_*) in production
# 7. DNS propagation can take up to 48 hours after adding custom domain
# 8. SSL certificates are auto-provisioned by Replit for custom domains
