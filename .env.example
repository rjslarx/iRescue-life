# ============================================================================
# iRescue.life Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# Required variables are marked with [REQUIRED]
# Optional variables are marked with [OPTIONAL]
# ============================================================================

# ============================================================================
# DATABASE [REQUIRED]
# ============================================================================
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/irescue

# Individual PostgreSQL connection parameters (alternative to DATABASE_URL)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_password
# PGDATABASE=irescue

# ============================================================================
# SECURITY [REQUIRED]
# ============================================================================
# Session secret for Express sessions (min 32 characters)
SESSION_SECRET=your-secure-session-secret-min-32-characters

# Encryption key for sensitive data like API keys (min 32 characters)
ENCRYPTION_KEY=your-secure-encryption-key-min-32-characters

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Server port (default: 5000)
PORT=5000

# Environment mode: development or production
NODE_ENV=development

# Allowed origins for CORS (comma-separated)
# Required in production mode
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ============================================================================
# EMAIL SERVICE [REQUIRED for email functionality]
# ============================================================================
# Resend API key for email delivery
# Sign up at https://resend.com
RESEND_API_KEY=re_your_resend_api_key

# Platform-level Resend key (for platform admin emails)
# PLATFORM_RESEND_API_KEY=re_your_platform_resend_api_key

# Resend webhook secret for tracking email events
# RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================================================
# STRIPE PAYMENTS [REQUIRED for payment processing]
# ============================================================================
# Your Stripe secret key
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe publishable key (for frontend)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# ============================================================================
# STRIPE CONNECT (Platform Fees)
# ============================================================================
# Set to 'true' if running the managed/hosted version of iRescue.life
IS_HOSTED_PLATFORM=false

# Platform's Stripe Connect account ID (for fee collection)
# STRIPE_CONNECT_PLATFORM_ID=acct_your_platform_account

# Platform's Stripe secret key (for Connect operations)
# PLATFORM_STRIPE_SECRET_KEY=sk_live_your_platform_key

# Stripe Connect OAuth Client ID (for tenant onboarding)
# Get from Stripe Dashboard > Settings > Connect > Settings
# STRIPE_CLIENT_ID=ca_your_client_id

# Testing mode configuration
# STRIPE_TEST_MODE=true
# TESTING_STRIPE_SECRET_KEY=sk_test_your_test_key
# TESTING_STRIPE_CLIENT_ID=ca_test_your_test_client_id

# Platform fee percentage for free tier (default: 5)
# PLATFORM_FEE_PERCENT=5

# Skip platform fees (DEVELOPMENT ONLY - never use in production)
# SKIP_PLATFORM_FEES=true

# ============================================================================
# OBJECT STORAGE [OPTIONAL - for file uploads]
# ============================================================================
# These are auto-configured by Replit Object Storage
# For other providers, configure accordingly
# PRIVATE_OBJECT_DIR=.private
# PUBLIC_OBJECT_SEARCH_PATHS=public

# ============================================================================
# GOOGLE WORKSPACE INTEGRATION [OPTIONAL]
# ============================================================================
# OAuth 2.0 credentials for Google Workspace features
# (Gmail, Calendar, Drive integration)
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Picker API key (for Drive file selection)
# GOOGLE_PICKER_API_KEY=your_picker_api_key

# ============================================================================
# AI INTEGRATIONS [OPTIONAL]
# ============================================================================
# OpenAI API key for AI Help Assistant
# AI_INTEGRATIONS_OPENAI_API_KEY=sk-your_openai_api_key

# Google Gemini API for AI features
# AI_INTEGRATIONS_GEMINI_API_KEY=your_gemini_api_key
# AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ============================================================================
# SMS NOTIFICATIONS [OPTIONAL]
# ============================================================================
# Twilio credentials for SMS alerts
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# ALTERNATIVE PAYMENT METHODS [OPTIONAL]
# ============================================================================
# PayPal credentials (when enabled by platform admin)
# PAYPAL_CLIENT_ID=your_paypal_client_id
# PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# ============================================================================
# IOT INTEGRATIONS [OPTIONAL]
# ============================================================================
# Govee API for temperature monitoring
# GOVEE_API_KEY=your_govee_api_key

# ============================================================================
# DEMO/DEVELOPMENT
# ============================================================================
# Password for demo tenant admin account
# DEMO_ADMIN_PASSWORD=ChangeMeInProduction123!

# Build version identifier (auto-generated in production)
# BUILD_VERSION=development
